# Provider-agnostic configuration
# Examples: openai, anthropic, gemini, azure, bedrock, groq, deepseek,
# mistral, openrouter, ollama, together_ai, hosted_vllm, or any LiteLLM provider.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=replace-me
# Optional custom/OpenAI-compatible endpoint
# AI_API_BASE=https://api.example.com/v1
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
AI_MAX_HISTORY_MESSAGES=40
AI_MAX_TOOL_ROUNDS=6

# Provider-specific credentials may also be read by LiteLLM, for example:
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
# OPENROUTER_API_KEY=...
